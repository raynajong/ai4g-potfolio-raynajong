{
  "name": "Daily Mental Health Check-in",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Daily Check-in",
        "formDescription": "Take a moment to check in with yourself. Rate each from 1 to 10.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Mood (1-10)",
              "fieldType": "number",
              "fieldName": "mood",
              "placeholder": "1 = very low, 10 = great",
              "requiredField": true
            },
            {
              "fieldLabel": "Stress (1-10)",
              "fieldType": "number",
              "fieldName": "stress",
              "placeholder": "1 = calm, 10 = very stressed",
              "requiredField": true
            },
            {
              "fieldLabel": "Energy (1-10)",
              "fieldType": "number",
              "fieldName": "energy",
              "placeholder": "1 = drained, 10 = energized",
              "requiredField": true
            },
            {
              "fieldLabel": "Main concern",
              "fieldType": "dropdown",
              "fieldName": "concern",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Work or study"
                  },
                  {
                    "option": "Relationships"
                  },
                  {
                    "option": "Sleep"
                  },
                  {
                    "option": "Health"
                  },
                  {
                    "option": "Money"
                  },
                  {
                    "option": "Loneliness"
                  },
                  {
                    "option": "Feeling overwhelmed"
                  },
                  {
                    "option": "Nothing in particular"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Anything you want to add? (optional)",
              "fieldType": "textarea",
              "fieldName": "note"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
